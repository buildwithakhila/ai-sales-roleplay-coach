# AssemblyAI (Speech-to-Text, and Week 2's persona LLM via the LLM Gateway).
# Get this after activating hackathon credits.
ASSEMBLYAI_API_KEY=

# Deepgram (Text-to-Speech, Aura). Free trial credit, no card usually
# required: https://console.deepgram.com/signup
DEEPGRAM_API_KEY=
# Optional: pick a specific Aura voice model. See
# https://developers.deepgram.com/docs/tts-models for the full list.
# (Each roleplay persona also picks its own voice — this is just the default.)
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Optional (Week 2): override the LLM Gateway endpoint/model used for the
# persona's replies. Defaults below work out of the box with just the
# ASSEMBLYAI_API_KEY above — see https://www.assemblyai.com/docs/llm-gateway
ASSEMBLYAI_LLM_URL=https://llm-gateway.assemblyai.com/v1/chat/completions
ASSEMBLYAI_LLM_MODEL=qwen3.5-4b-32k-fast

PORT=3000
